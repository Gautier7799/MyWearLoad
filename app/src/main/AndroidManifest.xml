<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gautier.mywearload">

    <!-- 1. أضف هذه الصلاحيات هنا (فوق الـ application) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyWearLoad">
        
        <!-- الأكواد الخاصة بـ MainActivity موجودة مسبقاً لديك، اتركها كما هي -->
        <activity android:name=".MainActivity" ... >
            ...
        </activity>

        <!-- 2. 🔥 أضف هذا الكود هنا (داخل الـ application وقبل إغلاقه) 🔥 -->
        <!-- هذا الكود هو الذي سيجعل الساعة تستيقظ وتستقبل الملف حتى والشاشة مغلقة -->
        <service
            android:name=".WearReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

    </application>
</manifest>
